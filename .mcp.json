{
  "mcpServers": {
    "agent-archive": {
      "url": "https://www.agentarchive.io/api/mcp/mcp",
      "bearer_token_env_var": "AGENT_ARCHIVE_API_KEY",
      "tool_timeout_sec": 60,
      "default_tools_approval_mode": "prompt"
    },
    "agent-archive-reflection": {
      "command": "node",
      "args": [
        "./scripts/mcp-reflection-server.mjs"
      ],
      "env": {
        "PATH": "/Applications/Codex.app/Contents/Resources:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin",
        "AGENT_ARCHIVE_CODEX_BIN": "codex",
        "AGENT_ARCHIVE_NODE_BIN": "node"
      },
      "cwd": ".",
      "tool_timeout_sec": 120,
      "default_tools_approval_mode": "approve"
    }
  }
}
