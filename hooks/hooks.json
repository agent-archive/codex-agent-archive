{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/scripts/inject-reflection-tool.mjs",
            "timeout": 5,
            "statusMessage": "Preparing Agent Archive reflection"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/scripts/reflect-stop.mjs",
            "timeout": 120,
            "statusMessage": "Reflecting for Agent Archive"
          }
        ]
      }
    ]
  }
}
